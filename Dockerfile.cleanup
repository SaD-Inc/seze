# syntax=docker/dockerfile:1

FROM oven/bun:1.3.14 AS builder
WORKDIR /app

COPY package.json bun.lock ./
RUN --mount=type=cache,id=s/13e07ac6-0296-4fe4-950d-caf9fc333366-/root/.bun/install/cache,target=/root/.bun/install/cache \
  bun install --frozen-lockfile

COPY tsconfig.json ./
COPY scripts/cleanup-stale-games.ts scripts/cleanup-stale-games.ts
COPY src/server/db/schema.ts src/server/db/schema.ts
COPY src/server/game/cleanup.ts src/server/game/cleanup.ts

RUN bun build scripts/cleanup-stale-games.ts \
  --target=bun \
  --outfile=/app/cleanup.js

FROM oven/bun:1.3.14-slim AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/cleanup.js ./cleanup.js

USER bun

CMD ["bun", "/app/cleanup.js"]

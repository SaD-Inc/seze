{
  "name": "seze",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14 <2"
  },
  "scripts": {
    "build": "next build && node scripts/prepare-standalone.mjs",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run build",
    "db:start": "docker compose up -d --wait postgres",
    "db:stop": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "bun run db:start && bun run db:migrate && next dev --turbo",
    "format": "biome check --write src scripts next.config.js drizzle.config.ts package.json tsconfig.json components.json biome.json",
    "format:check": "biome check src scripts next.config.js drizzle.config.ts package.json tsconfig.json components.json biome.json",
    "preview": "bun run build && bun run start",
    "start": "bun run db:migrate && node .next/standalone/server.js",
    "test": "bun test src/**/*.test.ts",
    "verify:production": "bun scripts/verify-production.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.34.0",
    "next": "^15.2.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.4",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/bun": "^1.4.0",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.30.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  }
}
